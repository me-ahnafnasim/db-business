{
  "name": "react-native-starter",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "start:tunnel": "expo start --dev-client --tunnel",
    "android": "expo start --dev-client --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:i18n": "node scripts/check-translations.js",
    "check": "npm run check:i18n && npx expo export --platform web --output-dir /tmp/nobosole-apk-check",
    "clean:icons": "node scripts/remove-unused-icons.js",
    "build:development": "eas build --platform android --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "build:development:android": "eas build --platform android --profile development",
    "build:preview:android": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@supabase/supabase-js": "2.110.3",
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "i18next": "^26.3.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.9",
    "react-native": "0.81.5",
    "react-native-url-polyfill": "3.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "~0.21.1"
  },
  "devDependencies": {
    "babel-preset-expo": "~54.0.6"
  }
}
