{
  "name": "nobosole-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "start:tunnel": "expo start --dev-client --tunnel",
    "android": "expo start --dev-client --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "npx expo export --platform web --output-dir dist && node scripts/copy-public-pages.js dist",
    "check:i18n": "node scripts/check-translations.js",
    "check:tokens": "node scripts/check-tokens.js",
    "check:syntax": "node scripts/check-syntax.js",
    "check:guest": "node scripts/check-guest-contract.js",
    "check": "npm run check:syntax && npm run check:i18n && npm run check:tokens && npm run check:guest && npm run check:catalog && npm run check:delivery && npx expo export --platform web --output-dir /tmp/nobosole-apk-check && node scripts/copy-public-pages.js /tmp/nobosole-apk-check",
    "check:release": "npm run check && node scripts/check-release-config.js && npx expo export --platform android --clear --output-dir /tmp/nobosole-android-release-check",
    "make:icons": "node scripts/make-placeholder-icons.js",
    "fit:icons": "node scripts/fit-adaptive-icon.js",
    "prebuild:check": "npx expo prebuild --platform android --no-install --clean",
    "build:development": "eas build --platform android --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "npm run check:release && eas build --platform android --profile production",
    "submit:internal": "eas submit --platform android --profile production",
    "check:catalog": "node scripts/check-catalog-contract.js",
    "check:delivery": "node scripts/check-delivery-options.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@supabase/supabase-js": "2.110.3",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "i18next": "^26.3.6",
    "react": "19.1.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "3.0.0"
  },
  "devDependencies": {
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~54.0.6",
    "expo-dev-client": "~6.0.21",
    "react-dom": "19.1.0",
    "react-native-web": "~0.21.1"
  }
}
