# Production default: https://nobosole-backend.vercel.app/api/v1
# Override for local development (Android emulator: http://10.0.2.2:3000/api/v1)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Supabase Auth. Use only the public/publishable key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Required for web OAuth redirects; also add this URL in Supabase Auth settings.
EXPO_PUBLIC_WEB_URL=http://localhost:8081

# Google OAuth identifier used by native Google Sign-In.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1029591703083-h56ftm0r97ni2g9cj1a7od95n86o8aqb.apps.googleusercontent.com
